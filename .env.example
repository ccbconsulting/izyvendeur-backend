# Copiez ce fichier en ".env" (ou configurez ces variables dans Render) et remplissez les vraies valeurs.

# Le "Verify Token" : une chaine secrete que VOUS inventez (ex: "izyvendeur-2026-secret").
# C'est vous qui la choisissez - elle doit etre EXACTEMENT la meme ici et dans le champ
# "Verifier le token" du tableau de bord Meta (Etape 2 > Configurer des webhooks).
VERIFY_TOKEN=changez-moi-avec-un-secret-a-vous

# Le token d'acces PERMANENT genere via l'Utilisateur Systeme (Business Settings > System Users).
# Ne JAMAIS mettre ce fichier .env dans un depot public une fois rempli.
WHATSAPP_TOKEN=collez_ici_le_token_permanent

# Le "Phone Number ID" de VOTRE vrai numero a vous (celui affiche dans WhatsApp Manager / API Setup),
# PAS celui du numero de test. Sert uniquement a creer automatiquement le premier marchand ("default")
# au tout premier demarrage. Les marchands suivants s'ajoutent depuis /admin, pas ici.
PHONE_NUMBER_ID=collez_ici_le_phone_number_id

# Port local (Render fournit automatiquement sa propre valeur, ne pas y toucher en production).
PORT=3000

# URL de connexion PostgreSQL (donnee par Render quand vous creez une base de donnees).
# Si cette variable est absente, le serveur retombe sur un simple fichier data.json local
# (pratique pour tester sans base, mais a NE PAS utiliser en production : les donnees seraient
# perdues a chaque redeploiement). Voir le README pour la marche a suivre sur Render.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/nom_base

# Nom d'utilisateur et mot de passe pour proteger l'interface d'administration /admin et son API (qui
# affichent les telephones, adresses et noms de vos clients, pour TOUS les marchands). Sans
# ADMIN_PASSWORD, l'acces est refuse (par securite, plutot que de rester ouvert a tout le monde).
# Choisissez un mot de passe que vous seul connaissez.
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-avec-un-mot-de-passe-a-vous
